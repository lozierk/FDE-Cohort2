# LUMINA — copy to .env and fill in. .env is git-ignored; never commit real keys.
# Both services read this file from the repo root.

# ---------- MongoDB Atlas (documents, memory, cache, jobs, vectors, GridFS) ----------
# Atlas free tier (M0) is enough for two weeks. A local mongod has no Vector Search:
# see VECTOR_BACKEND below.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lumina

# atlas-vector-search (default) | mongo-cosine-scan (local mongod fallback, /health must say so)
VECTOR_BACKEND=atlas-vector-search

# ---------- LLM ----------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
# Optional. Defaults to LLM_MODEL. Only the synthesis call — the one that writes the answer —
# runs on this model; planning and research stay on LLM_MODEL.
# LLM_MODEL_SYNTHESIS=claude-sonnet-5
# Optional. Defaults to LLM_MODEL_SYNTHESIS. The deep answer only. Measured 2026-09-14: Sonnet 5
# here cites twice the sources and reads as one argument for 12-20% more cost under the $0.35
# cap, while on the quick answer it only slowed first paint. The shipped setting:
LLM_MODEL_SYNTHESIS_DEEP=claude-sonnet-5
ANTHROPIC_API_KEY=

# ---------- Search (swappable with no code change) ----------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=
SEARCH_CACHE_TTL_SECONDS=21600

# ---------- OpenAI (embeddings; needed even when the LLM is Anthropic) ----------
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# openai (default) | fake. Inherits `fake` only when LLM_PROVIDER=fake.
EMBEDDING_PROVIDER=openai

# ---------- Deep search: the expensive gear, so the gates live here ----------
# Sub-questions a plan may hold. Fewer than 3 is a quick search with extra steps.
DEEP_SUB_QUESTIONS_MIN=3
DEEP_SUB_QUESTIONS_MAX=6
# Deep searches per X-User-Id per day. Over cap -> 429 {error, resetsAt}, enforced in the
# agent service. A cap you document but do not enforce is not a cap.
DEEP_DAILY_CAP=5
# Sub-questions researched at the same time. Without a fan-out the wall clock is the sum of
# the parts, and six sub-questions in series blow deep_answer_p95_s (90 s) on their own.
DEEP_CONCURRENCY=3
# Tool calls ONE sub-question may spend, its own first search included. The shared
# MAX_TOOL_CALLS_DEEP still binds: this only stops one sub-question eating the whole budget.
DEEP_SUB_TOOL_CALLS=4
# Passages deep synthesis reads per sub-question. A fixed share each, so a sub-question that
# found three good pages is not crowded out by one that found fifteen mediocre ones.
DEEP_PASSAGES_PER_SUB=4
# Passages deep synthesis reads in total, across all sub-questions.
DEEP_PASSAGE_LIMIT=20

# ---------- Loop caps (the hard caps from AGENTS.md; do not raise to pass a gate) ----------
MAX_TOOL_CALLS=8
MAX_WALL_CLOCK_SEC=90
# Deep gets a wider envelope because it is doing more, not because it is allowed to sprawl.
MAX_TOOL_CALLS_DEEP=24
MAX_WALL_CLOCK_SEC_DEEP=240

# ---------- Jobs worker (parsing, chunking, embedding, indexing — never the request path) ----------
# child (default): the agent forks the worker at boot. none: it does not (tests, or `npm run worker`).
WORKER=child
# Poll interval when the last poll found nothing. After a job it polls again immediately.
WORKER_POLL_MS=2000
# A `running` job whose claimedAt is older than this is swept back to `pending`.
WORKER_LEASE_SEC=120
# After this many claims the job is `failed` and the document `failed` with the last error.
WORKER_MAX_ATTEMPTS=3

# ---------- Ingest & retrieval (declared in src/config/rag.ts; these are the overrides) ----------
# multer limits.fileSize in megabytes; over it the upload is a 413.
MAX_UPLOAD_MB=25
# Target chunk length in characters (~250 tokens) and the overlap between neighbours.
CHUNK_CHARS=1000
CHUNK_OVERLAP_CHARS=150
# Texts per embedding call.
EMBED_BATCH=64
# Chunks search_documents returns and registers as sources — the recall@5 window.
RAG_TOP_K=5
# Results taken from EACH ranker (vector, BM25) before RRF fusion.
RAG_CANDIDATES=20
# $vectorSearch.numCandidates: how many approximate neighbours the index visits.
RAG_VECTOR_NUM_CANDIDATES=100
# The RRF constant. 60 is the value from Cormack, Clarke and Buettcher (2009).
RAG_RRF_K=60

# ---------- Ports & wiring ----------
PORT_GATEWAY=8787
PORT_AGENT=8000
AGENT_URL=http://localhost:8000
# Comma-separated origins the gateway accepts. Add your Vercel URL before you deploy.
CORS_ORIGINS=http://localhost:5173
# Per X-User-Id, per minute, at the gateway. The code default is 30 (fails safe if unset).
# The bench runs ONE user id at concurrency 4 and polls uploads every 1.2 s: ~100-150 req/min at
# peak. Set 300 wherever the bench will run (local and the deployed gateway) - 3x headroom and
# still a real limit against a runaway client. Not a graded threshold.
RATE_LIMIT_PER_MINUTE=300
LOG_LEVEL=info

# ---------- Web (Vite; only VITE_* reaches the browser — never put a key here) ----------
VITE_API_URL=http://localhost:8787
# Document searches the model may add on top of the loop's own first search, per quick request.
# Enforced in the loop. In docs mode on a fresh thread the loop answers straight from the first
# search when it found anything; the model turn only runs for auto mode, follow-ups, or a miss.
DOCS_EXTRA_SEARCHES=1
