# LUMINA agent service — private Fly app. Build context is Claude_Build/ (the npm workspace
# root) because the agent depends on the workspace package @lumina/contract.
#
#   fly deploy -c fly.agent.toml        # from Claude_Build/

# ---- build: install every workspace's deps, compile contract + agent -------------------
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/contract/package.json packages/contract/
COPY backend/agent/package.json backend/agent/
COPY backend/gateway/package.json backend/gateway/
COPY web/package.json web/
RUN npm ci
COPY packages/contract packages/contract
COPY backend/agent backend/agent
RUN npm run build -w @lumina/contract && npm run build -w @lumina/agent

# ---- runtime: production deps only, compiled JS only --------------------------------------
FROM node:22-slim
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/contract/package.json packages/contract/
COPY backend/agent/package.json backend/agent/
COPY backend/gateway/package.json backend/gateway/
COPY web/package.json web/
RUN npm ci --omit=dev -w @lumina/contract -w @lumina/agent && npm cache clean --force
COPY --from=build /app/packages/contract/dist packages/contract/dist
COPY --from=build /app/backend/agent/dist backend/agent/dist

# index.js forks its sibling worker.js (one code path for tsx and node — see src/index.ts).
WORKDIR /app/backend/agent
ENV PORT=8000
ENV RUNS_DIR=/tmp/runs
EXPOSE 8000
CMD ["node", "dist/index.js"]
